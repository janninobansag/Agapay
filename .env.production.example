# Public HTTPS origin. This is baked into the frontend at image build time.
NEXT_PUBLIC_APP_URL="https://agapay.example.com"
NEXT_PUBLIC_OSM_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# Runtime-only secrets. Never commit a populated .env.production file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-a-32-byte-random-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="report-evidence"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
PORT="3000"
