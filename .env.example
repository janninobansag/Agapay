# Database connection used by Prisma.
DATABASE_URL="postgresql://agapay:agapay@localhost:5432/agapay?schema=public"

# Auth.js secret. Generate a unique value for every deployed environment.
AUTH_SECRET="replace-with-a-random-secret"

# Optional social sign-in. Create developer applications before setting these.
# Redirect URIs: http://localhost:3000/api/auth/callback/google and
# http://localhost:3000/api/auth/callback/facebook
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# Public base URL used by authentication and email links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Future email integration; leave blank until its milestone is implemented.
RESEND_API_KEY=""

# Private evidence storage. Find these in Supabase Project Settings > API.
# Never expose or commit the service-role key.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="report-evidence"

# Replaceable OpenStreetMap endpoints used by the map and server-side geocoder.
NEXT_PUBLIC_OSM_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"

# Optional seed override. Never reuse a real personal password.
SEED_DEMO_PASSWORD="AgapayDemo123!"
