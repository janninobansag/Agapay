generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RESIDENT
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CANCELLED
}

enum ReportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MediaType {
  IMAGE
}

enum NotificationType {
  REPORT_SUBMITTED
  REPORT_VERIFIED
  REPORT_ASSIGNED
  REPORT_UPDATED
  REPORT_RESOLVED
  REPORT_REJECTED
}

model User {
  id                        String     @id @default(cuid())
  email                     String     @unique @db.VarChar(320)
  name                      String     @db.VarChar(100)
  passwordHash              String?
  role                      UserRole   @default(RESIDENT)
  status                    UserStatus @default(ACTIVE)
  inAppNotificationsEnabled Boolean    @default(true)
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  reports         Report[]            @relation("ReportReporter")
  assignedReports Report[]            @relation("AssignedStaff")
  reportEvents    ReportStatusEvent[]
  notifications   Notification[]
  teamMemberships TeamMember[]
  auditLogs       AuditLog[]

  @@index([role, status])
}

model IssueCategory {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(60)
  name        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(240)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reports Report[]

  @@index([isActive, name])
}

model ServiceArea {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(120)
  boundary  Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]
  teams   ResponseTeam[]

  @@index([isActive, name])
}

model ResponseTeam {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(120)
  contactEmail  String?  @db.VarChar(320)
  isActive      Boolean  @default(true)
  serviceAreaId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceArea ServiceArea? @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  members     TeamMember[]
  reports     Report[]

  @@unique([name, serviceAreaId])
  @@index([serviceAreaId, isActive])
}

model TeamMember {
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team ResponseTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model Report {
  id              String         @id @default(cuid())
  publicId        String         @unique @db.VarChar(24)
  title           String         @db.VarChar(100)
  description     String         @db.VarChar(1000)
  status          ReportStatus   @default(DRAFT)
  priority        ReportPriority @default(NORMAL)
  address         String         @db.VarChar(240)
  latitude        Float?
  longitude       Float?
  reporterId      String
  categoryId      String
  serviceAreaId   String?
  assignedTeamId  String?
  assignedStaffId String?
  submittedAt     DateTime?
  verifiedAt      DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  reporter      User                @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  category      IssueCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  serviceArea   ServiceArea?        @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  assignedTeam  ResponseTeam?       @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)
  assignedStaff User?               @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  media         ReportMedia[]
  statusHistory ReportStatusEvent[]
  notifications Notification[]

  @@index([reporterId, createdAt(sort: Desc)])
  @@index([status, submittedAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([serviceAreaId, status])
  @@index([assignedTeamId, status])
  @@index([assignedStaffId, status])
}

model ReportMedia {
  id        String    @id @default(cuid())
  type      MediaType @default(IMAGE)
  url       String
  objectKey String    @unique
  mimeType  String    @db.VarChar(100)
  sizeBytes Int
  altText   String?   @db.VarChar(240)
  reportId  String
  createdAt DateTime  @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

model ReportStatusEvent {
  id         String        @id @default(cuid())
  fromStatus ReportStatus?
  toStatus   ReportStatus
  note       String?       @db.VarChar(500)
  reportId   String
  actorId    String?
  createdAt  DateTime      @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String           @db.VarChar(120)
  body      String           @db.VarChar(500)
  userId    String
  reportId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([reportId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(80)
  entityId   String   @db.VarChar(100)
  metadata   Json?
  actorId    String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
